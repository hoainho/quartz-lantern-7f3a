# Copy to .env and fill in. Never commit .env.

# --- Vector store provider (OpenAI) ---
OPENAI_API_KEY=
# Existing vector store to sync into. Leave empty to create one on first run.
OPENAI_VECTOR_STORE_ID=

# --- Source (Zendesk Help Center) ---
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
# Minimum number of articles to ingest per run (sanity floor, assignment requires >= 30)
MIN_ARTICLES=30

# --- Runtime ---
DATA_DIR=data/articles
LOG_LEVEL=INFO
