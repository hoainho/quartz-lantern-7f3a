# Copy to .env and fill in. Never commit .env.

# --- Vector store provider (Gemini File Search) ---
GEMINI_API_KEY=
# Existing File Search store to sync into (fileSearchStores/...). Leave empty to create one on first run.
GEMINI_FILE_SEARCH_STORE=
# Model used by the sanity-check CLI (must support File Search)
GEMINI_MODEL=gemini-3.6-flash
# Parallel uploads (first full sync is ~400 files at ~10 s each; 429s are retried with backoff)
UPLOAD_WORKERS=4

# --- Source (Zendesk Help Center) ---
ZENDESK_BASE_URL=https://support.optisigns.com
ZENDESK_LOCALE=en-us
# Minimum number of articles to ingest per run (sanity floor, assignment requires >= 30)
MIN_ARTICLES=30

# --- Runtime ---
DATA_DIR=data/articles
LOG_LEVEL=INFO
